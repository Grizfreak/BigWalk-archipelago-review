<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must match the .NET runtime BepInEx IL2CPP ships with the game (6.0.7). -->
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The interop DLLs carry an incomplete NullableAttribute (CS0656). -->
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>BigWalkArchipelago</AssemblyName>
    <RootNamespace>BigWalkArchipelago</RootNamespace>
    <!-- Keep in step with Plugin.PluginVersion: package-mod.ps1 names the zip from it. -->
    <Version>1.0.15</Version>

    <!-- Copies the NuGet client next to the plugin; BepInEx references stay Private=false. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDefaultItems>true</EnableDefaultItems>

    <!-- net6.0 is out of support, but it is the runtime BepInEx ships. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Official Archipelago client; it bundles its own Newtonsoft.Json. -->
    <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- From <game>/BepInEx/core/, see lib/README.md. -->
    <Reference Include="BepInEx.Core">
      <HintPath>..\lib\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>..\lib\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Game interop generated by Il2CppInterop, not the Il2CppInspector dummies. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>..\lib\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror">
      <HintPath>..\lib\Mirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\lib\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AudioSystem">
      <HintPath>..\lib\AudioSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>..\lib\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>..\lib\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>..\lib\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- URP render scale and upscaling filter. -->
    <Reference Include="Unity.RenderPipelines.Universal.Runtime">
      <HintPath>..\lib\Unity.RenderPipelines.Universal.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.RenderPipelines.Core.Runtime">
      <HintPath>..\lib\Unity.RenderPipelines.Core.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The game's transports, used by the loopback guest. -->
    <Reference Include="Mirror.Transports">
      <HintPath>..\lib\Mirror.Transports.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Input stack, used by the loopback guest. -->
    <Reference Include="DissonanceVoip">
      <HintPath>..\lib\DissonanceVoip.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rewired_Core">
      <HintPath>..\lib\Rewired_Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>..\lib\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\lib\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- OnGUI, for the status overlay. -->
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\lib\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>..\lib\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>..\lib\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- The feature namespaces, so files need no using line for each other. -->
  <ItemGroup>
    <Using Include="BigWalkArchipelago.Core" />
    <Using Include="BigWalkArchipelago.Core.Net" />
    <Using Include="BigWalkArchipelago.Patches" />
    <Using Include="BigWalkArchipelago.Core.Items" />
    <Using Include="BigWalkArchipelago.Core.Gourds" />
    <Using Include="BigWalkArchipelago.Core.Keys" />
    <Using Include="BigWalkArchipelago.Core.Towers" />
    <Using Include="BigWalkArchipelago.Core.Doors" />
    <Using Include="BigWalkArchipelago.Core.Puzzles" />
    <Using Include="BigWalkArchipelago.Core.Checks" />
    <Using Include="BigWalkArchipelago.Core.Abilities" />
    <Using Include="BigWalkArchipelago.Core.Tiles" />
    <Using Include="BigWalkArchipelago.Core.Visuals" />
    <Using Include="BigWalkArchipelago.Core.Effects" />
    <Using Include="BigWalkArchipelago.Core.Hub" />
    <Using Include="BigWalkArchipelago.Core.Diagnostics" />
    <Using Include="BigWalkArchipelago.Patches.Abilities" />
    <Using Include="BigWalkArchipelago.Patches.Doors" />
    <Using Include="BigWalkArchipelago.Patches.Towers" />
    <Using Include="BigWalkArchipelago.Patches.Effects" />
    <Using Include="BigWalkArchipelago.Patches.Checks" />
    <Using Include="BigWalkArchipelago.Patches.Gourds" />
    <Using Include="BigWalkArchipelago.Patches.Puzzles" />
    <Using Include="BigWalkArchipelago.Patches.Keys" />
    <Using Include="BigWalkArchipelago.Patches.Hub" />
    <Using Include="BigWalkArchipelago.Patches.Items" />
    <Using Include="BigWalkArchipelago.Patches.Menus" />
    <Using Include="BigWalkArchipelago.Patches.Compat" />
  </ItemGroup>

  <!-- The debug tools are left out of the released DLL. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Compile Remove="Debug\**" />
  </ItemGroup>

  <!-- Custom tiles embedded as tiles.<name>.png. -->
  <ItemGroup>
    <EmbeddedResource Include="..\assets\tiles\*\*.png" Exclude="..\assets\tiles\source\**" LogicalName="tiles.%(Filename).png" />
  </ItemGroup>
</Project>
